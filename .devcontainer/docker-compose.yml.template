# Template. `./dev setup <project-name>` renders this into docker-compose.yml;
# nothing runs against this file directly.
#
# __PROJECT_NAME__ becomes the compose project name, and compose prefixes every
# named volume with it. That is what makes this a template rather than a single
# environment: two copies on the same machine never share a workspace, a cache,
# a git identity or a Claude Code login, without you having to rename anything
# below.

name: __PROJECT_NAME__

services:
  dev:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        USER_UID: "${USER_UID:-1000}"
        USER_GID: "${USER_GID:-1000}"
        # `./dev setup <name> --with-orca` writes "true" here; see the Orca step
        # at the end of the Dockerfile. Kept in this file rather than passed on
        # the command line so every build of this project agrees, devcontainer
        # tooling included. `./dev setup <name> --force` carries it across.
        WITH_ORCA: "__WITH_ORCA__"

    # Tagged per project as well. Each copy of this template owns its Dockerfile
    # and will drift as you add packages to it; a shared tag would mean one
    # project's rebuild silently swaps out the image another project is running.
    image: __PROJECT_NAME__-dev:latest

    hostname: __PROJECT_HOSTNAME__
    init: true
    stdin_open: true
    tty: true

    # Survives client disconnects by design.
    command: ["sleep", "infinity"]

    environment:
      TERM: xterm-256color
      COLORTERM: truecolor
      # macOS Docker Desktop exposes the host SSH agent at this fixed path.
      SSH_AUTH_SOCK: /ssh-agent

    # Orca's headless server, when you start it with `./dev orca`. Published on
    # every interface on purpose: the address a remote client pairs with is the
    # *host's* -- its Tailscale address, say -- and the host forwards to here,
    # so Tailscale never has to run inside the container. Pairing needs a token
    # either way, but if you would rather not have the port on your LAN at all,
    # narrow this to "127.0.0.1:16768:6768" and put `tailscale serve` in front.
    #
    # Host 16768, container 6768, and the difference matters: Orca's desktop app
    # listens on 6768 itself, so a client dialling this machine on 6768 reaches
    # that app instead of this container. It shows up as "the host is not the
    # one that the code is for" on the client, with the desktop app reporting an
    # unpaired device at the same moment. `./dev orca` reads the host side of
    # this mapping and advertises it, so changing the number here is enough.
    ports:
      - "16768:6768"

    volumes:
      # Source lives in a named volume, not a bind mount. On macOS this avoids
      # virtiofs, which is what makes LSP indexing crawl when the editor runs
      # inside the container.
      - workspace:/home/dev/src

      # Caches worth keeping across rebuilds.
      - cargo-registry:/usr/local/cargo/registry
      - uv-cache:/home/dev/.cache/uv

      # Orca's runtime state: orchestration.db, the per-client pairing tokens
      # and the end-to-end encryption keys. Without these, every rebuild means
      # re-pairing every client -- the same trap as ~/.claude below.
      - orca-config:/home/dev/.config/orca
      - orca-state:/home/dev/.orca
      - nvim-state:/home/dev/.local/state/nvim

      # Claude Code credentials and chat history, so you authenticate once
      # rather than per rebuild. See the note on ~/.claude.json in bashrc.extra:
      # this volume alone is not sufficient to keep you logged in.
      - claude-config:/home/dev/.claude

      # git config --global writes to ~/.config/git/config under XDG, so your
      # identity and aliases persist without bind-mounting host dotfiles.
      - git-config:/home/dev/.config/git

      # Host SSH agent, for cloning private repos without copying keys into the
      # image. macOS Docker Desktop only; see README for Linux.
      - /run/host-services/ssh-auth.sock:/ssh-agent

      # The exchange directory: <repo>/mount on the Mac, /mount inside. This is
      # the seam between the two worlds — context to hand to Claude, generated
      # artifacts to keep, or a host clone you push commits into. A bind mount
      # precisely because both sides must see it; keep source you actively edit
      # in the workspace volume above, where virtiofs is not in the way.
      - ../mount:/mount

      # TIPS.md, read-only. `:Tips` and the startup quick reference render
      # straight from this file, so editing it on the host updates the editor
      # immediately rather than at the next rebuild. `./dev up` creates a stub
      # if it is missing, because Docker would otherwise helpfully make a
      # directory here and the greeting would silently go blank.
      - ../TIPS.md:/home/dev/.config/nvim/TIPS.md:ro

      # Anything added by `./dev mount <host-path> <name>` lands between these
      # two markers, as /other-mounts/<name>. The markers are how the script
      # finds its own entries, so leave them in place; the lines between them
      # are ordinary compose syntax and safe to edit or delete by hand.
      # >>> extra mounts
      # <<< extra mounts

    # rust-analyzer and basedpyright are memory-hungry on large workspaces.
    # Raise if you index something big; remove to use Docker's defaults.
    deploy:
      resources:
        limits:
          memory: 8g

volumes:
  workspace:
  cargo-registry:
  uv-cache:
  orca-config:
  orca-state:
  nvim-state:
  claude-config:
  git-config:
