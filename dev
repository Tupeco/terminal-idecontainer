#!/usr/bin/env bash
# Thin wrapper around the container lifecycle. Two things are worth knowing:
#
#   `setup`  renders docker-compose.yml from the template, which is what turns
#            this repo into something you copy per project rather than a single
#            environment you keep re-pointing at different code.
#   `attach` reconnects to a tmux session that never stopped running, which is
#            the whole reason the container outlives your laptop's sleep cycle.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
DCDIR="$ROOT/.devcontainer"
TEMPLATE="$DCDIR/docker-compose.yml.template"
COMPOSE_FILE="$DCDIR/docker-compose.yml"
MOUNT_DIR="$ROOT/mount"

MARK_BEGIN='# >>> extra mounts'
MARK_END='# <<< extra mounts'
ORCA_BEGIN='# >>> orca only'
ORCA_END='# <<< orca only'
NARRATOR_BEGIN='# >>> narrator only'
NARRATOR_END='# <<< narrator only'
PORTS_KEY_BEGIN='# >>> ports key'
PORTS_KEY_END='# <<< ports key'
# Where `setup` starts looking for a free host port for Orca and the narrator,
# and how far. The ranges do not overlap, so the two never pick the same port
# in one run.
ORCA_PORT_BASE=16768
NARRATOR_PORT_BASE=16868
PORT_SPAN=100

COMPOSE=(docker compose)
SERVICE=dev

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: ./dev <command>

First, once per copy of this template:

  setup <name> [--with-orca [--orca-port <port>] | --without-orca]
               [--with-postgres | --without-postgres]
               [--with-narrator [--narrator-port <port>]
                                [--narrator-model int8|full]
                | --without-narrator]
               [--force]
            Render docker-compose.yml from the template for a project called
            <name>. The name prefixes every named volume, so each project gets
            its own workspace, caches, git identity and Claude Code login.
            --with-orca includes the Orca server (below) in the image and
            publishes it on a host port of this project's own: the first free
            one from 16768 up, or <port>. Both are stored in
            docker-compose.yml, so every up and rebuild keeps them.
            --with-postgres installs PostgreSQL in the image; up starts it,
            with its data in a volume that rebuilds keep.
            --with-narrator installs the narrated-walkthrough tools (below)
            and publishes the narrator's player on a host port of its own,
            the first free one from 16868 up, or <port>; up starts it.
            --narrator-model picks its speech model: int8 (114 MB, the
            default) or full (326 MB), which sounds clearer but synthesises
            about three times slower, barely keeping up with playback.
            Changing it rebuilds only the model step.
            --force re-renders over an existing file, carrying your `mount`
            entries, the Orca, PostgreSQL and narrator choices, their ports
            and the narrator's model across (use it after pulling template changes). A port moves only
            if another project's container now publishes it too. Add the
            --with-/--without- flags to change a choice.
  reconfigure [the same options as setup, except <name> and --force]
            setup <name> --force, with <name> read from the existing
            docker-compose.yml. The same carry-over applies.

Day to day:

  up        Build if needed and start the container in the background, and
            PostgreSQL and the Orca server too where the project has them
  attach    Attach to the persistent tmux session (use this every morning)
  shell     Plain bash shell, no tmux
  clone     Clone a repo into the workspace volume: ./dev clone <git-url>
  stop      Stop the container (volumes and their contents survive)
  rebuild   Rebuild the image from scratch, keeping all volumes
  nuke      Remove the container AND all volumes, including your source

  up and rebuild show the build parameters setup stored and ask before
  building. With no terminal to answer, they go ahead.

Orca server (an IDE for a fleet of agents; this container runs the runtime,
your Mac or phone runs the UI). Only in a project set up --with-orca:

  orca [address]
            Start it and print the pairing URL. If it is already running, say
            where it listens and leave it alone. With no address it advertises
            this machine's Tailscale address, or its LAN address if Tailscale
            is not running. Pass one to override. Not the container's address,
            and not 127.0.0.1: clients dial this machine, and Docker forwards
            the published port inward.
  orca-url  Print the pairing URL and its QR code again (it is a secret;
            treat it as one)
  orca-stop Stop it
  orca-log  Follow its log
  orca-update
            Install the latest Orca release in the container and restart the
            server on it, if it is running. Lasts until the container is
            recreated; it says which ORCA_VERSION to pin to keep it.

Narrated walkthroughs (:Walkthrough in Neovim; Claude Code explains the code
aloud while moving a highlight through it). Only in a project set up
--with-narrator:

  narrator-url
            Print the player page's address, with its token. Open it in the
            browser that should do the listening -- here, on another machine,
            or on a phone over Tailscale -- and press Start listening.
  narrator  Start the narrator if it is not running (up does this), then
            print the address as narrator-url does
  narrator-log
            Follow its log

Sharing directories with the host:

  <repo>/mount is always bind-mounted at /mount inside the container.

  mount <host-path> <name>
            Also bind <host-path> at /other-mounts/<name>
  mount     With no arguments, list the extra mounts
  unmount <name>
            Remove the /other-mounts/<name> entry

  Mount changes are written to docker-compose.yml; run `./dev up` to apply.
EOF
}

require_setup() {
  [ -f "$COMPOSE_FILE" ] || die "not set up yet in $(basename "$ROOT") — run: ./dev setup <project-name>"
}

# The rendered compose file's own project name, for messages that tell you
# which setup command to run.
project_name() {
  awk '/^name:/ { print $2; exit }' "$COMPOSE_FILE"
}

# Whether this project's image includes Orca: "true" or "false", from the build
# args `setup` wrote. Empty for a file rendered before the setting existed,
# which the Dockerfile's default turns into "false".
orca_setting() {
  awk -F'"' '/^[[:space:]]*WITH_ORCA:/ { print $2; exit }' "$COMPOSE_FILE"
}

# The same for PostgreSQL, from the WITH_POSTGRES build arg.
postgres_setting() {
  awk -F'"' '/^[[:space:]]*WITH_POSTGRES:/ { print $2; exit }' "$COMPOSE_FILE"
}

# And for the narrator, from WITH_NARRATOR.
narrator_setting() {
  awk -F'"' '/^[[:space:]]*WITH_NARRATOR:/ { print $2; exit }' "$COMPOSE_FILE"
}

# The narrator's Kokoro model, from NARRATOR_MODEL: int8 or full. Empty
# for a file that predates the setting, where the Dockerfile's int8 applies.
narrator_model_setting() {
  awk -F'"' '/^[[:space:]]*NARRATOR_MODEL:/ { print $2; exit }' "$COMPOSE_FILE"
}

# Show the build parameters and ask before building. The parameters are already
# settled in docker-compose.yml, so this is a last look rather than a question
# that must be answered: with no terminal on stdin (a script, a pipe) it goes
# ahead.
# The host side of the /ssh-agent mount, exported for compose to interpolate.
# Docker Desktop for Mac exposes the host's agent at a fixed path inside its
# VM; a socket on the Mac itself cannot be bind-mounted through it. On Linux
# the socket is an ordinary file wherever $SSH_AUTH_SOCK says, and that moves
# with every login of a forwarded agent, so this is worked out on each run
# rather than written into docker-compose.yml once. Setting HOST_SSH_AUTH_SOCK
# yourself wins, for hosts neither guess fits (Docker Desktop on Linux uses the
# Mac path).
find_ssh_agent() {
  if [ -n "${HOST_SSH_AUTH_SOCK:-}" ]; then
    SSH_AGENT_NOTE="set by HOST_SSH_AUTH_SOCK"
  elif [ "$(uname -s)" = Darwin ]; then
    HOST_SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock
    SSH_AGENT_NOTE="Docker Desktop for Mac"
  elif [ -S "${SSH_AUTH_SOCK:-}" ]; then
    HOST_SSH_AUTH_SOCK="$SSH_AUTH_SOCK"
    SSH_AGENT_NOTE="from \$SSH_AUTH_SOCK"
  else
    # Something has to be mounted, and a path that does not exist would be
    # created by Docker as a root-owned directory. /dev/null is not a socket,
    # so ssh inside simply finds no agent, as it would with none running.
    HOST_SSH_AUTH_SOCK=/dev/null
    SSH_AGENT_NOTE="none: \$SSH_AUTH_SOCK is not a socket here"
  fi
  export HOST_SSH_AUTH_SOCK
}

confirm_build() {
  local ok
  printf 'Build parameters, from %s:\n' "${COMPOSE_FILE#"$ROOT"/}"
  case "$(orca_setting)" in
    true)
      local port
      port="$(orca_host_port)"
      printf '  Orca server   included, on host port %s\n' "${port:-(none)}"
      warn_port_clash "$port"
      ;;
    false) printf '  Orca server   not included\n' ;;
    *) printf '  Orca server   not included: this file predates the setting\n' ;;
  esac
  case "$(postgres_setting)" in
    true) printf '  PostgreSQL    included, started by up\n' ;;
    false) printf '  PostgreSQL    not included\n' ;;
    *) printf '  PostgreSQL    not included: this file predates the setting\n' ;;
  esac
  case "$(narrator_setting)" in
    true)
      local nport
      nport="$(narrator_host_port)"
      printf '  Narrator      included, started by up, player on host port %s\n' "${nport:-(none)}"
      printf '                Kokoro model %s\n' "$(narrator_model_setting | grep . || echo 'int8 (the default; this file predates the setting)')"
      warn_port_clash "$nport"
      ;;
    false) printf '  Narrator      not included\n' ;;
    *) printf '  Narrator      not included: this file predates the setting\n' ;;
  esac
  printf '  To change:    ./dev reconfigure --with-orca | --without-orca\n'
  printf '                                  --with-postgres | --without-postgres\n'
  printf '                                  --with-narrator | --without-narrator\n'
  printf '                                  --narrator-model int8 | full\n'
  printf 'Host SSH agent, found on every run:\n'
  printf '  %s (%s)\n' "$HOST_SSH_AUTH_SOCK" "$SSH_AGENT_NOTE"
  [ -t 0 ] || return 0
  read -r -p "Build with these? [y/N] " ok || ok=""
  case "$ok" in
    y | Y | yes | YES) ;;
    *) echo "aborted"; exit 1 ;;
  esac
}

# up and rebuild used to take --with-orca. Say where it went rather than
# ignoring it.
no_build_options() {
  [ $# -eq 0 ] \
    || die "unexpected argument: $1 (build parameters are set by ./dev setup; see ./dev help)"
}

# The lines currently between the two markers, if any.
# The address a client dials to reach the Orca server, which is *this*
# machine's: port 6768 is published, so clients connect here and Docker
# forwards into the container. Loopback is deliberately not a fallback -- the
# server rejects a pairing whose advertised host does not match the connection
# it actually gets, and through a published port nothing arrives on loopback.
# Prints "<address> <where it came from>".
host_address() {
  local ip="" ts iface
  for ts in tailscale /Applications/Tailscale.app/Contents/MacOS/Tailscale; do
    if command -v "$ts" >/dev/null 2>&1; then
      # `tailscale ip` answers with the last address it was assigned even when
      # the daemon is stopped or logged out, so ask whether it is up first --
      # otherwise this hands out a tailnet address that routes nowhere.
      if "$ts" status >/dev/null 2>&1; then
        ip="$("$ts" ip -4 2>/dev/null | head -n1 || true)"
        [ -n "$ip" ] && { printf '%s tailscale\n' "$ip"; return 0; }
      fi
    fi
  done
  # macOS: the address of whichever interface carries the default route.
  iface="$(route -n get default 2>/dev/null | awk '/interface:/ { print $2 }')"
  if [ -n "$iface" ]; then
    ip="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
    [ -n "$ip" ] && { printf '%s LAN (%s)\n' "$ip" "$iface"; return 0; }
  fi
  # Linux, for the same script on a non-Mac host.
  ip="$(ip -4 route get 1.1.1.1 2>/dev/null \
        | awk '{ for (i = 1; i <= NF; i++) if ($i == "src") print $(i + 1) }')"
  [ -n "$ip" ] && { printf '%s LAN\n' "$ip"; return 0; }
  return 1
}

# The host side of the published mapping for container port $1, read from the
# rendered compose file so the two cannot drift apart. Empty when the file
# publishes nothing for it.
host_port_for() {
  awk -F'"' -v cport="$1" '$0 ~ "^[[:space:]]*-[[:space:]]*\"[0-9.:]+:" cport "\"[[:space:]]*$" {
       n = split($2, a, ":"); print a[n - 1]; exit }' "$COMPOSE_FILE" 2>/dev/null
}

# Orca's: the container's 6768. Not 6768 on the host: Orca's desktop app
# listens there. See docker-compose.yml.template.
orca_host_port() { host_port_for 6768; }

# The narrator player's: the container's 6769.
narrator_host_port() { host_port_for 6769; }

# Every host port published by a container on this machine, running or
# stopped, as "<port> <compose project>" lines; "-" for a container outside
# compose. Stopped ones count because they take their ports back when they
# start, and that is exactly the clash this is for. Fails when Docker does not
# answer.
published_ports() {
  local ids
  ids="$(docker ps -aq 2>/dev/null)" || return 1
  [ -n "$ids" ] || return 0
  # shellcheck disable=SC2086  # one argument per container id
  docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}|{{range $p, $b := .HostConfig.PortBindings}}{{range $b}}{{.HostPort}} {{end}}{{end}}' \
    $ids 2>/dev/null \
    | awk -F'|' '{ n = split($2, ps, " ")
                   for (i = 1; i <= n; i++) print ps[i], ($1 == "" ? "-" : $1) }'
}

# Why host port $1 cannot be project $2's, or nothing if it can. Reads
# PORTS_IN_USE from published_ports. The project's own container holding it is
# no clash; something else listening on it is, Docker or not.
port_clash() {
  local holder
  holder="$(printf '%s\n' "$PORTS_IN_USE" \
    | awk -v p="$1" -v own="$2" '$1 == p && $2 != own { print $2; exit }')"
  if [ "$holder" = - ]; then
    printf 'a container outside compose publishes it'
  elif [ -n "$holder" ]; then
    printf 'project %s publishes it too' "$holder"
  elif printf '%s\n' "$PORTS_IN_USE" \
         | awk -v p="$1" -v own="$2" '$1 == p && $2 == own { f = 1 } END { exit !f }'; then
    return 0
  elif (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; then
    printf 'something on this machine is listening on it'
  fi
}

# Choose one of project $1's host ports: $2 if asked for, else $3 (what the
# old file had) unless that now clashes, else the first free one from $4. $5
# is a port this run has already given to something else, never chosen again;
# $6 names the option that sets it, for the error; $7 is what to tell the user
# when a carried-over port has to move. Sets CHOSEN_PORT, and CHOSEN_PORT_NOTE
# to say how it was chosen. Used for Orca and the narrator alike.
choose_port() {
  # Plain strings, not an array: macOS's bash 3.2 treats an empty array as
  # unset under `set -u`.
  local own="$1" asked="$2" had="$3" base="$4" taken="$5" flag="$6" after_move="$7"
  local clash="" p how="" caveat=""
  if ! PORTS_IN_USE="$(published_ports)"; then
    PORTS_IN_USE=""
    caveat="Docker did not answer, so other projects' ports went unchecked"
  fi
  CHOSEN_PORT=""
  if [ -n "$asked" ]; then
    [ "$asked" != "$taken" ] || die "$flag $asked: that port is already this project's other published port"
    CHOSEN_PORT="$asked"
    clash="$(port_clash "$asked" "$own")"
    [ -z "$clash" ] || how="warning: $clash"
  elif [ -n "$had" ]; then
    clash="$(port_clash "$had" "$own")"
    [ "$had" != "$taken" ] || clash="this project's other published port now uses it"
    if [ -z "$clash" ]; then
      CHOSEN_PORT="$had"
      how="carried over"
    else
      how="moved from $had, where $clash${after_move:+; $after_move}"
    fi
  fi
  if [ -z "$CHOSEN_PORT" ]; then
    for p in $(seq "$base" $((base + PORT_SPAN - 1))); do
      if [ "$p" != "$taken" ] && [ -z "$(port_clash "$p" "$own")" ]; then
        CHOSEN_PORT="$p"
        break
      fi
    done
    [ -n "$CHOSEN_PORT" ] \
      || die "no free port in $base-$((base + PORT_SPAN - 1)); pick one with $flag <port>"
  fi
  CHOSEN_PORT_NOTE="$how${how:+${caveat:+; }}$caveat"
  [ -z "$CHOSEN_PORT_NOTE" ] || CHOSEN_PORT_NOTE=" ($CHOSEN_PORT_NOTE)"
}

# confirm_build's line for one published port: warn if it now clashes. setup
# checked, but another project may have been set up since.
warn_port_clash() {
  local port="$1" clash
  [ -n "$port" ] || return 0
  PORTS_IN_USE="$(published_ports)" || return 0
  clash="$(port_clash "$port" "$(project_name)")"
  if [ -n "$clash" ]; then
    printf '  warning:      port %s: %s, so the container may fail to start.\n' "$port" "$clash"
    printf '                ./dev reconfigure moves it to a free one.\n'
  fi
}

extra_mounts() {
  awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
    index($0, e) { f = 0 }
    f
    index($0, b) { f = 1 }
  ' "$COMPOSE_FILE"
}

# Insert a block immediately above the closing marker.
insert_mounts() {
  local block="$1" tmp
  [ -n "$block" ] || return 0
  tmp="$COMPOSE_FILE.tmp"
  awk -v e="$MARK_END" -v ins="$block" '
    index($0, e) { print ins }
    { print }
  ' "$COMPOSE_FILE" > "$tmp"
  mv "$tmp" "$COMPOSE_FILE"
}

cmd_setup() {
  local name="" force="" orca="" orca_note="" carried="" host tmp
  local asked_port="" had_port="" postgres="" postgres_note=""
  local narrator="" narrator_note="" asked_nport="" had_nport=""
  local nmodel="" nmodel_note="" nmodel_asked=""
  local orca_port="" orca_port_note="" narrator_port="" narrator_port_note=""
  local usage="usage: ./dev setup <project-name> [--with-orca [--orca-port <port>] | --without-orca] [--with-postgres | --without-postgres] [--with-narrator [--narrator-port <port>] [--narrator-model int8|full] | --without-narrator] [--force]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --with-orca) orca=true ;;
      --without-orca) orca=false ;;
      --with-postgres) postgres=true ;;
      --without-postgres) postgres=false ;;
      --with-narrator) narrator=true ;;
      --without-narrator) narrator=false ;;
      --orca-port)
        [ $# -ge 2 ] || die "$usage"
        asked_port="$2"
        shift
        ;;
      --narrator-port)
        [ $# -ge 2 ] || die "$usage"
        asked_nport="$2"
        shift
        ;;
      --narrator-model)
        [ $# -ge 2 ] || die "$usage"
        nmodel="$2"
        nmodel_asked=1
        shift
        ;;
      -*) die "unknown option: $1" ;;
      *) [ -z "$name" ] || die "$usage"
         name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || die "$usage"
  if [ -n "$asked_port" ]; then
    [[ "$asked_port" =~ ^[0-9]+$ ]] && [ "$asked_port" -ge 1024 ] && [ "$asked_port" -le 65535 ] \
      || die "--orca-port takes a port number from 1024 to 65535 (got: $asked_port)"
  fi
  if [ -n "$asked_nport" ]; then
    [[ "$asked_nport" =~ ^[0-9]+$ ]] && [ "$asked_nport" -ge 1024 ] && [ "$asked_nport" -le 65535 ] \
      || die "--narrator-port takes a port number from 1024 to 65535 (got: $asked_nport)"
  fi
  # The Dockerfile checks too, but failing here means before a build has
  # started, with the choices spelt out.
  case "$nmodel" in
    "" | int8 | full) ;;
    *) die "--narrator-model takes int8 or full (got: $nmodel)" ;;
  esac
  [ -f "$TEMPLATE" ] || die "missing template: $TEMPLATE"

  # Compose's own rule for project names, enforced here so the failure arrives
  # with an explanation rather than as a compose error three commands later.
  [[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] \
    || die "project name must be lowercase letters, digits, dashes or underscores, starting with a letter or digit (got: $name)"

  if [ -f "$COMPOSE_FILE" ]; then
    [ -n "$force" ] \
      || die "$COMPOSE_FILE already exists. Pass --force to re-render it (your mount entries and Orca choice are carried over)."
    carried="$(extra_mounts)"
    had_port="$(orca_host_port)"
    had_nport="$(narrator_host_port)"
    # Remembered like the mounts, unless this run says otherwise. A file from
    # before the setting has nothing to carry, so say so rather than quietly
    # settling on "not included".
    if [ -z "$orca" ]; then
      orca="$(orca_setting)"
      if [ -n "$orca" ]; then
        orca_note=" (carried over)"
      else
        orca_note=" (the old file predates this setting; pass --with-orca to include it)"
      fi
    fi
    # A file from before this setting simply had no PostgreSQL, so unlike Orca
    # there is nothing to point out.
    if [ -z "$postgres" ]; then
      postgres="$(postgres_setting)"
      [ -z "$postgres" ] || postgres_note=" (carried over)"
    fi
    # Nor for the narrator.
    if [ -z "$narrator" ]; then
      narrator="$(narrator_setting)"
      [ -z "$narrator" ] || narrator_note=" (carried over)"
    fi
    # The model too, even while the narrator is switched off, so turning it
    # back on later does not quietly reset the model to int8.
    if [ -z "$nmodel" ]; then
      nmodel="$(narrator_model_setting)"
      [ -z "$nmodel" ] || nmodel_note=" (carried over)"
    fi
  fi
  orca="${orca:-false}"
  postgres="${postgres:-false}"
  narrator="${narrator:-false}"
  nmodel="${nmodel:-int8}"
  if [ "$orca" = true ]; then
    choose_port "$name" "$asked_port" "$had_port" "$ORCA_PORT_BASE" "" \
      --orca-port "pair clients again"
    orca_port="$CHOSEN_PORT"
    orca_port_note="$CHOSEN_PORT_NOTE"
  elif [ -n "$asked_port" ]; then
    die "--orca-port is for a project with Orca; add --with-orca"
  fi
  # After Orca's, and told which port Orca took, so the two cannot coincide
  # even when --orca-port lands in the narrator's range.
  if [ "$narrator" = true ]; then
    choose_port "$name" "$asked_nport" "$had_nport" "$NARRATOR_PORT_BASE" "$orca_port" \
      --narrator-port "reopen the player from ./dev narrator-url"
    narrator_port="$CHOSEN_PORT"
    narrator_port_note="$CHOSEN_PORT_NOTE"
  elif [ -n "$asked_nport" ]; then
    die "--narrator-port is for a project with the narrator; add --with-narrator"
  elif [ -n "$nmodel_asked" ]; then
    die "--narrator-model is for a project with the narrator; add --with-narrator"
  fi

  # Underscores are legal in a compose project name but not in a hostname.
  host="${name//_/-}"

  # Without Orca, drop the template's Orca-only block (its published port) as
  # well as setting the build arg. The port has to be free on the host whether
  # or not anything listens behind it, so leaving it in would let Orca's port
  # stop a container that has no Orca from starting. The same for the
  # narrator's block, and the `ports:` key goes when neither is left under it.
  local render=(-e "s/__PROJECT_NAME__/$name/g"
                -e "s/__PROJECT_HOSTNAME__/$host/g"
                -e "s/__WITH_ORCA__/$orca/g"
                -e "s/__WITH_POSTGRES__/$postgres/g"
                -e "s/__WITH_NARRATOR__/$narrator/g"
                -e "s/__NARRATOR_MODEL__/$nmodel/g")
  if [ "$orca" = true ]; then
    render+=(-e "s/__ORCA_PORT__/$orca_port/g")
  else
    render+=(-e "/$ORCA_BEGIN/,/$ORCA_END/d")
  fi
  if [ "$narrator" = true ]; then
    render+=(-e "s/__NARRATOR_PORT__/$narrator_port/g")
  else
    render+=(-e "/$NARRATOR_BEGIN/,/$NARRATOR_END/d")
  fi
  if [ "$orca" != true ] && [ "$narrator" != true ]; then
    render+=(-e "/$PORTS_KEY_BEGIN/,/$PORTS_KEY_END/d")
  fi

  tmp="$COMPOSE_FILE.tmp"
  sed "${render[@]}" "$TEMPLATE" > "$tmp"
  mv "$tmp" "$COMPOSE_FILE"
  insert_mounts "$carried"

  mkdir -p "$MOUNT_DIR"

  printf 'Set up project "%s".\n' "$name"
  printf '  compose file : %s\n' "${COMPOSE_FILE#"$ROOT"/}"
  printf '  volumes      : %s_workspace, %s_claude-config, ...\n' "$name" "$name"
  printf '  exchange dir : %s -> /mount\n' "${MOUNT_DIR#"$ROOT"/}"
  if [ "$orca" = true ]; then
    printf '  Orca server  : included%s\n' "$orca_note"
    printf '  Orca port    : %s%s\n' "$orca_port" "$orca_port_note"
  else
    printf '  Orca server  : not included%s\n' "$orca_note"
  fi
  if [ "$postgres" = true ]; then
    printf '  PostgreSQL   : included%s; up starts it\n' "$postgres_note"
  else
    printf '  PostgreSQL   : not included%s\n' "$postgres_note"
  fi
  if [ "$narrator" = true ]; then
    printf '  Narrator     : included%s; up starts it\n' "$narrator_note"
    printf '  Player port  : %s%s\n' "$narrator_port" "$narrator_port_note"
    printf '  Voice model  : %s%s\n' "$nmodel" "$nmodel_note"
  else
    printf '  Narrator     : not included%s\n' "$narrator_note"
  fi
  if [ -n "$carried" ]; then
    printf '  carried over %d extra mount(s)\n' "$(printf '%s\n' "$carried" | grep -c .)"
  fi
  printf '\nNext: ./dev up\n'
}

# `setup --force` under the name the file already has, so re-rendering after a
# template pull does not mean looking the name up first. Only options pass
# through: a name here would either repeat the current one or rename the
# project, and renaming means new, empty volumes, which deserves the explicit
# `setup <new-name> --force` spelling.
cmd_reconfigure() {
  require_setup
  local name arg prev=""
  for arg in "$@"; do
    case "$arg" in
      -*) ;;
      # The value after an option that takes one is the only bare word allowed.
      *) [ "$prev" = --orca-port ] || [ "$prev" = --narrator-port ] || [ "$prev" = --narrator-model ] \
           || die "reconfigure keeps the project's name; to rename, run: ./dev setup <new-name> --force" ;;
    esac
    prev="$arg"
  done
  name="$(project_name)"
  [ -n "$name" ] || die "no 'name:' line in $COMPOSE_FILE. Run: ./dev setup <project-name> --force"
  cmd_setup "$name" --force "$@"
}

cmd_mount() {
  require_setup
  local host_path="${1:-}" name="${2:-}" abs

  if [ -z "$host_path" ]; then
    local current; current="$(extra_mounts)"
    if [ -z "$current" ]; then
      echo "No extra mounts. Add one with: ./dev mount <host-path> <name>"
    else
      echo "Extra mounts (from ${COMPOSE_FILE#"$ROOT"/}):"
      printf '%s\n' "$current" | sed 's/^ *- */  /; s/"//g'
    fi
    return 0
  fi

  [ -n "$name" ] || die "usage: ./dev mount <host-path> <mount-name>"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || die "mount name must be alphanumeric, dashes, dots or underscores (got: $name)"
  [ -e "$host_path" ] || die "no such file or directory: $host_path"

  # Absolute, so the entry does not depend on where you ran this from. The
  # generated compose file is local to this copy anyway, so it is free to name
  # host paths directly.
  if [ -d "$host_path" ]; then
    abs="$(cd "$host_path" && pwd)"
  else
    abs="$(cd "$(dirname "$host_path")" && pwd)/$(basename "$host_path")"
  fi

  if grep -qF ":/other-mounts/$name\"" "$COMPOSE_FILE"; then
    die "/other-mounts/$name is already mounted. Remove it first: ./dev unmount $name"
  fi

  insert_mounts "      - \"$abs:/other-mounts/$name\""
  printf 'Mounted %s -> /other-mounts/%s\n' "$abs" "$name"
  printf 'Run ./dev up to apply (this recreates the container; tmux state inside is lost).\n'
}

cmd_unmount() {
  require_setup
  local name="${1:-}" tmp
  [ -n "$name" ] || die "usage: ./dev unmount <mount-name>"
  if ! grep -qF ":/other-mounts/$name\"" "$COMPOSE_FILE"; then
    die "/other-mounts/$name is not mounted. See: ./dev mount"
  fi

  tmp="$COMPOSE_FILE.tmp"
  grep -vF ":/other-mounts/$name\"" "$COMPOSE_FILE" > "$tmp"
  mv "$tmp" "$COMPOSE_FILE"
  printf 'Unmounted /other-mounts/%s. Run ./dev up to apply.\n' "$name"
}

# `./dev orca [address]`, and what `up` runs for a project with Orca. With
# --from-up the pairing URL is not printed: pairings live in the orca-config
# and orca-state volumes, so clients paired before a restart reconnect without
# it, and `./dev orca-url` shows it when you do want it. -T there as well,
# because `up` may run without a terminal.
cmd_orca() {
  # Strings rather than arrays: an empty array under `set -u` is an error in
  # bash 3.2, which is what macOS runs this script with.
  local addr state found port start_opts="" no_tty=""
  if [ "${1:-}" = --from-up ]; then
    shift
    start_opts=--no-url
    no_tty=-T
  fi
  # Before working out addresses, so a project without Orca fails at once.
  # orca-server checks again inside, which also covers a file that predates
  # the setting.
  [ "$(orca_setting)" != false ] \
    || die "$(project_name) is set up without Orca. Add it: ./dev reconfigure --with-orca && ./dev up"
  cd "$DCDIR"
  addr="${1:-}"
  # Already running? Say where it listens and stop there: restarting would
  # drop any client sessions attached to it, and the advertised address is
  # fixed at startup anyway. -T because the output is captured, and the
  # status line is only worth printing when there is a server to describe.
  if [ -z "$addr" ]; then
    state="$("${COMPOSE[@]}" exec -T "$SERVICE" bash -lc 'orca-server status' 2>/dev/null || true)"
    case "$state" in
      running*)
        printf '%s\n' "$state"
        echo "Left running. Pairing URL: ./dev orca-url"
        return 0
        ;;
    esac
    found="$(host_address || true)"
    [ -n "$found" ] \
      || die "could not work out this machine's address; pass one: ./dev orca <address>"
    addr="${found%% *}"
    echo "Using $addr, this machine's ${found#* } address. Pass one to override."
  fi
  # An address without a port gets the published one. `orca serve` honours a
  # host:port pairing address, so the container keeps its own 6768 and only
  # the advertised number changes.
  case "$addr" in
    *:*) ;;
    *)
      port="$(orca_host_port)"
      [ -n "$port" ] \
        || die "docker-compose.yml publishes no Orca port. Re-render it: ./dev reconfigure --with-orca && ./dev up"
      addr="$addr:$port"
      ;;
  esac
  echo "Advertising ws://$addr"
  # The mapping lives in docker-compose.yml; `setup --force` adds it to an
  # older rendering.
  "${COMPOSE[@]}" exec ${no_tty:+"$no_tty"} "$SERVICE" bash -lc "orca-server start '$addr' $start_opts" \
    || return 1
  [ -z "$start_opts" ] || echo "Pairing URL, if a client needs one: ./dev orca-url"
}

require_narrator() {
  [ "$(narrator_setting)" = true ] \
    || die "$(project_name) is set up without the narrator. Add it: ./dev reconfigure --with-narrator && ./dev up"
}

# `./dev narrator-url`: where a browser finds the player. The token comes from
# the container (`narrator url-path`); the address is this machine's, as for
# Orca, because the port is published here and Docker forwards it inward.
# localhost is offered too, since a browser on this machine reaches a
# published port that way, which Orca's pairing (with its address check)
# cannot do.
cmd_narrator_url() {
  local path port found
  require_narrator
  port="$(narrator_host_port)"
  [ -n "$port" ] \
    || die "docker-compose.yml publishes no narrator port. Re-render it: ./dev reconfigure --with-narrator && ./dev up"
  cd "$DCDIR"
  path="$("${COMPOSE[@]}" exec -T "$SERVICE" bash -lc 'narrator url-path')" || return 1
  echo "Narrator player -- open one in the browser that should listen, then press Start listening:"
  if found="$(host_address)"; then
    printf '  http://%s:%s%s   (%s)\n' "${found%% *}" "$port" "$path" "${found#* }"
  fi
  printf '  http://localhost:%s%s   (this machine only)\n' "$port" "$path"
  echo "The token in it is a secret: anyone with the link hears what is narrated."
}

# `up` and `rebuild` start PostgreSQL, the narrator and Orca in a project that
# includes them, since a recreated container comes back with none running, and
# each is the reason the project has it. Best effort: by now the container is
# up whatever happens to them, so a failure is a warning, not a failed `up`.
# Orca runs in a subshell because cmd_orca dies on errors. Only for "true": a
# file that predates a setting has none of them in its image. `narrator start`
# is safe to repeat in the same way as `pg start` below.
#
# PostgreSQL first, as it takes a second and an application started from the
# shell expects it. `pg start` is safe to repeat: on a container that was
# already running it reports the server and leaves it alone, and on the very
# first `up` it creates the cluster. -T because `up` may run without a
# terminal.
start_services_after_up() {
  if [ "$(postgres_setting)" = true ]; then
    "${COMPOSE[@]}" exec -T "$SERVICE" bash -lc 'pg start' \
      || echo "warning: PostgreSQL did not start; run pg start inside, or see pg log" >&2
  fi
  # The narrator before Orca too: it is quick, and Orca's start is the one
  # that prints the most.
  if [ "$(narrator_setting)" = true ]; then
    if "${COMPOSE[@]}" exec -T "$SERVICE" bash -lc 'narrator start'; then
      echo "Narrator player address: ./dev narrator-url"
    else
      echo "warning: the narrator did not start; try ./dev narrator, or see ./dev narrator-log" >&2
    fi
  fi
  if [ "$(orca_setting)" = true ]; then
    echo "Starting the Orca server..."
    ( cmd_orca --from-up ) \
      || echo "warning: the Orca server did not start; try ./dev orca, or see ./dev orca-log" >&2
  fi
}

# Before any compose command, so each one reads the file the way `up` did
# rather than falling back to the template's default.
find_ssh_agent

case "${1:-}" in
  setup)
    shift
    cmd_setup "$@"
    ;;
  reconfigure)
    shift
    cmd_reconfigure "$@"
    ;;
  mount)
    cmd_mount "${2:-}" "${3:-}"
    ;;
  unmount)
    cmd_unmount "${2:-}"
    ;;
  up)
    require_setup
    shift
    no_build_options "$@"
    confirm_build
    # Docker would create this as root if it were missing, leaving you a
    # directory inside the container you cannot write to.
    mkdir -p "$MOUNT_DIR"
    # docker-compose bind-mounts this file; if it is absent Docker creates a
    # directory in its place and the in-editor quick reference goes blank.
    if [ ! -f "$ROOT/TIPS.md" ]; then
      printf '# Tips\n\n## Quick reference\n\n| | |\n|---|---|\n| `:Tips` | This file |\n' > "$ROOT/TIPS.md"
      echo "note: created a stub TIPS.md (it is bind-mounted into the container)"
    fi
    cd "$DCDIR"
    "${COMPOSE[@]}" up -d --build
    echo "Container running. Attach with: ./dev attach"
    start_services_after_up
    ;;
  attach)
    require_setup
    cd "$DCDIR"
    exec "${COMPOSE[@]}" exec "$SERVICE" bash -lc 'tmux new-session -A -s main'
    ;;
  shell)
    require_setup
    cd "$DCDIR"
    exec "${COMPOSE[@]}" exec "$SERVICE" bash -l
    ;;
  clone)
    require_setup
    [ $# -ge 2 ] || die "usage: ./dev clone <git-url>"
    cd "$DCDIR"
    "${COMPOSE[@]}" exec "$SERVICE" bash -lc "cd ~/src && git clone '$2'"
    ;;
  orca)
    require_setup
    shift
    cmd_orca "$@"
    ;;
  orca-url)
    require_setup
    cd "$DCDIR"
    "${COMPOSE[@]}" exec "$SERVICE" bash -lc 'orca-server url'
    ;;
  orca-stop)
    require_setup
    cd "$DCDIR"
    "${COMPOSE[@]}" exec "$SERVICE" bash -lc 'orca-server stop'
    ;;
  orca-update)
    require_setup
    [ "$(orca_setting)" != false ] \
      || die "$(project_name) is set up without Orca. Add it: ./dev reconfigure --with-orca && ./dev up"
    cd "$DCDIR"
    "${COMPOSE[@]}" exec "$SERVICE" bash -lc 'orca-server update'
    ;;
  orca-log)
    require_setup
    cd "$DCDIR"
    exec "${COMPOSE[@]}" exec "$SERVICE" bash -lc 'orca-server log'
    ;;
  narrator)
    require_setup
    require_narrator
    (cd "$DCDIR" && "${COMPOSE[@]}" exec -T "$SERVICE" bash -lc 'narrator start')
    cmd_narrator_url
    ;;
  narrator-url)
    require_setup
    cmd_narrator_url
    ;;
  narrator-log)
    require_setup
    cd "$DCDIR"
    exec "${COMPOSE[@]}" exec "$SERVICE" bash -lc 'narrator log'
    ;;
  stop)
    require_setup
    cd "$DCDIR"
    "${COMPOSE[@]}" stop
    ;;
  rebuild)
    require_setup
    shift
    no_build_options "$@"
    confirm_build
    cd "$DCDIR"
    "${COMPOSE[@]}" build --no-cache
    "${COMPOSE[@]}" up -d
    start_services_after_up
    ;;
  nuke)
    require_setup
    read -r -p "This deletes the workspace volume and all source in it. Type YES: " ok
    [ "$ok" = "YES" ] || { echo "aborted"; exit 1; }
    cd "$DCDIR"
    "${COMPOSE[@]}" down -v
    ;;
  *)
    usage
    exit 1
    ;;
esac
