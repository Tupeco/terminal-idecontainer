#!/usr/bin/env bash
# The narrator inside this container, for a project set up --with-narrator: a
# text-to-speech MCP server for Claude Code whose speaker is a browser tab.
#
#   narrator start     start it in the background (`./dev up` does this)
#   narrator stop
#   narrator status
#   narrator log       follow its log
#   narrator url-path  the player's path and token, which `./dev narrator-url`
#                      on the host puts after this machine's address
#
# The server itself is /opt/narrator/app/narrator.py; its docstring says why it
# is shaped the way it is. Claude Code reaches it at http://127.0.0.1:6769/mcp,
# registered by bashrc.extra.
#
# A plain background process with a pidfile rather than a tmux session like
# orca-server: there is nothing interactive to attach to, and the log says
# everything worth knowing.
set -euo pipefail

# Overridable only so the script can be tried against a scratch install.
APP="${NARRATOR_HOME:-/opt/narrator}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$STATE/narrator.log"
PIDFILE="$STATE/narrator.pid"
TOKEN_FILE="$STATE/narrator-token"
PORT=6769

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[ -x "$APP/venv/bin/python" ] \
  || die "the narrator is not installed in this image. On the host: ./dev reconfigure --with-narrator && ./dev up"

# PIDs restart from 1 in a recreated container, so a pidfile left behind can
# name some unrelated process of ours. It is ours only if that process is
# running narrator.py.
pid() {
  local p
  p="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$p" ] && tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q 'narrator\.py' \
    && printf '%s\n' "$p"
}

cmd_start() {
  local p before i
  if p="$(pid)"; then
    printf 'The narrator is already running (pid %s)\n' "$p"
    return 0
  fi
  mkdir -p "$STATE"
  # Wait for this start's "listening" line, not an earlier run's.
  before=0
  [ ! -f "$LOG" ] || before="$(wc -l < "$LOG")"
  setsid "$APP/venv/bin/python" -I "$APP/app/narrator.py" \
    --port "$PORT" \
    --model "$APP/models/kokoro.onnx" \
    --voices "$APP/models/voices.bin" \
    --voice "${NARRATOR_VOICE:-af_heart}" \
    --token-file "$TOKEN_FILE" \
    >> "$LOG" 2>&1 < /dev/null &
  echo $! > "$PIDFILE"
  # Loading the model takes a second or two; give it twenty before calling it
  # a failure.
  for i in $(seq 40); do
    if tail -n +"$((before + 1))" "$LOG" | grep -q 'narrator listening on'; then
      printf 'The narrator is listening on container port %s\n' "$PORT"
      return 0
    fi
    pid >/dev/null || break
    sleep 0.5
  done
  tail -n +"$((before + 1))" "$LOG" >&2
  die "the narrator did not start; the log above is from $LOG"
}

cmd_stop() {
  local p i
  p="$(pid)" || { echo "The narrator is not running"; rm -f "$PIDFILE"; return 0; }
  kill "$p"
  for i in $(seq 20); do
    kill -0 "$p" 2>/dev/null || { rm -f "$PIDFILE"; echo "Stopped the narrator"; return 0; }
    sleep 0.25
  done
  kill -9 "$p" 2>/dev/null || true
  rm -f "$PIDFILE"
  echo "Stopped the narrator (it ignored SIGTERM)"
}

cmd_status() {
  local p
  if p="$(pid)"; then
    printf 'running (pid %s) on container port %s\n' "$p" "$PORT"
  else
    echo "not running"
    return 1
  fi
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  log) exec tail -n 50 -F "$LOG" ;;
  url-path)
    [ -s "$TOKEN_FILE" ] || die "no token yet: the narrator has not been started. Run: narrator start"
    printf '/?token=%s\n' "$(tr -d '\n' < "$TOKEN_FILE")"
    ;;
  *)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
