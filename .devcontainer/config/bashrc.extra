
# --- polyglot devcontainer -------------------------------------------------

export PATH="$HOME/.local/bin:/usr/local/cargo/bin:$PATH"
export EDITOR=hx
export VISUAL=hx

# HELIX_RUNTIME is intentionally not exported here. Mainline Helix and
# evil-helix both read it, and a single global value would point one of them at
# the other's grammars. The hx and ehx wrappers in /usr/local/bin each set it
# for their own process.

# uv: keep downloaded interpreters and the cache where the volumes are.
export UV_PYTHON_INSTALL_DIR=/opt/python
export UV_CACHE_DIR="$HOME/.cache/uv"

# Persist shell history across `docker exec` sessions.
export HISTFILE="$HOME/.local/state/bash_history"
export HISTSIZE=100000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
mkdir -p "$(dirname "$HISTFILE")"

# Group-writable by default, for unix sockets that a host process has to
# connect to. Connecting needs write permission on the socket, and bind()
# creates it with 0777 minus the umask, so under the usual 022 nginx on the host
# gets r-x and "Permission denied". A default ACL on the directory does not get
# round this: the kernel applies the umask to a socket itself, and the ACL mask
# that results is r-x as well (measured). With 002, a socket in a setgid
# directory whose group is nginx's comes out rwx for that group, and nothing has
# to be chowned after every restart. See "Serving to the host over a unix
# socket" in README.md. The cost is that other files become writable by your own
# group too, which in a single-user container is nobody else.
umask 002

alias ll='ls -lah --color=auto'
alias hxr='hx .'
alias ehxr='ehx .'

alias gitl='git log --all --oneline --decorate --graph --date-order'
alias gitlog='git log --all --decorate --graph --date-order'

# Keep ~/.claude.json pointing into the ~/.claude volume.
#
# The Dockerfile creates this link, so why do it again on every shell? Because
# the link only survives as long as nothing replaces it. An application that
# saves a file by write-temp-then-rename does not follow the link, it renames
# over it, leaving a plain file in the container layer that quietly stops
# persisting until the next rebuild. Checking here costs nothing and turns a
# silent regression into a self-repair. Copying the stray file back onto the
# volume before relinking means the login it contains survives the repair.
_link_claude_json() {
  local real="$HOME/.claude/claude.json" link="$HOME/.claude.json"
  [ -d "$HOME/.claude" ] || return 0
  [ -L "$link" ] && return 0
  if [ -f "$link" ]; then
    cp -f "$link" "$real" && rm -f "$link"
  fi
  [ -e "$real" ] || printf '{}\n' > "$real"
  ln -s "$real" "$link"
}
_link_claude_json

# Activate a project venv if one exists in the current directory.
venv() {
  if [ -f .venv/bin/activate ]; then
    # shellcheck disable=SC1091
    . .venv/bin/activate
  else
    echo "no .venv here; create one with: uv venv"
  fi
}

# Attach to the persistent tmux session, creating it if needed. This is the
# command you want after every laptop suspend.
work() {
  tmux new-session -A -s "${1:-main}"
}

if [ -n "$PS1" ] && [ -z "$TMUX" ]; then
  echo "Polyglot dev container. Run 'work' to attach to the persistent tmux session."
  echo "In a repo, 'nvim .' opens the file tree beside an editor; :Tips for the keys."
fi
