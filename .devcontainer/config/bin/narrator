#!/usr/bin/env bash
# The narrator inside this container, for a project set up --with-narrator: a
# text-to-speech MCP server for Claude Code whose speaker is a browser tab.
#
#   narrator start     start it in the background (`./dev up` does this)
#   narrator stop
#   narrator status
#   narrator log       follow its log
#   narrator url-path  the player's path and token, which `./dev narrator-url`
#                      on the host puts after this machine's address
#   narrator replay <file> [--nvim <socket>] [--root <dir>]
#                      play a tour saved under .tours/ with no Claude involved,
#                      highlighting in the Neovim at <socket> (else the one
#                      found for the project); prints the narrator's reply as
#                      JSON. `:WalkthroughReplayOffline` runs this.
#   narrator control prev|next|stop|continue
#                      the player's buttons, from a shell or from Neovim
#
# The server itself is /opt/narrator/app/narrator.py; its docstring says why it
# is shaped the way it is. Claude Code reaches it at http://127.0.0.1:6769/mcp,
# registered by bashrc.extra.
#
# A plain background process with a pidfile rather than a tmux session like
# orca-server: there is nothing interactive to attach to, and the log says
# everything worth knowing.
set -euo pipefail

# Overridable only so the script can be tried against a scratch install,
# beside the real one (another port, and XDG_STATE_HOME for its own token).
APP="${NARRATOR_HOME:-/opt/narrator}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$STATE/narrator.log"
PIDFILE="$STATE/narrator.pid"
TOKEN_FILE="$STATE/narrator-token"
PORT="${NARRATOR_PORT:-6769}"

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

[ -x "$APP/venv/bin/python" ] \
  || die "the narrator is not installed in this image. On the host: ./dev reconfigure --with-narrator && ./dev up"

# PIDs restart from 1 in a recreated container, so a pidfile left behind can
# name some unrelated process of ours. It is ours only if that process is
# running narrator.py.
pid() {
  local p
  p="$(cat "$PIDFILE" 2>/dev/null || true)"
  [ -n "$p" ] && { tr '\0' ' ' < "/proc/$p/cmdline"; } 2>/dev/null | grep -q 'narrator\.py' \
    && printf '%s\n' "$p"
}

cmd_start() {
  local p before i
  if p="$(pid)"; then
    printf 'The narrator is already running (pid %s)\n' "$p"
    return 0
  fi
  mkdir -p "$STATE"
  # Wait for this start's "listening" line, not an earlier run's.
  before=0
  [ ! -f "$LOG" ] || before="$(wc -l < "$LOG")"
  setsid "$APP/venv/bin/python" -I "$APP/app/narrator.py" \
    --port "$PORT" \
    --model "$APP/models/kokoro.onnx" \
    --voices "$APP/models/voices.bin" \
    --voice "${NARRATOR_VOICE:-af_heart}" \
    --token-file "$TOKEN_FILE" \
    >> "$LOG" 2>&1 < /dev/null &
  echo $! > "$PIDFILE"
  # Loading the model takes a second or two; give it twenty before calling it
  # a failure.
  for i in $(seq 40); do
    if tail -n +"$((before + 1))" "$LOG" | grep -q 'narrator listening on'; then
      printf 'The narrator is listening on container port %s\n' "$PORT"
      return 0
    fi
    pid >/dev/null || break
    sleep 0.5
  done
  tail -n +"$((before + 1))" "$LOG" >&2
  die "the narrator did not start; the log above is from $LOG"
}

cmd_stop() {
  local p i
  p="$(pid)" || { echo "The narrator is not running"; rm -f "$PIDFILE"; return 0; }
  kill "$p"
  for i in $(seq 20); do
    kill -0 "$p" 2>/dev/null || { rm -f "$PIDFILE"; echo "Stopped the narrator"; return 0; }
    sleep 0.25
  done
  kill -9 "$p" 2>/dev/null || true
  rm -f "$PIDFILE"
  echo "Stopped the narrator (it ignored SIGTERM)"
}

cmd_status() {
  local p
  if p="$(pid)"; then
    printf 'running (pid %s) on container port %s\n' "$p" "$PORT"
  else
    echo "not running"
    return 1
  fi
}

token() {
  [ -s "$TOKEN_FILE" ] || die "no token yet: the narrator has not been started. Run: narrator start"
  tr -d '\n' < "$TOKEN_FILE"
}

# POST a JSON body to one of the narrator's routes and print its JSON reply.
# --fail-with-body so that a refusal still prints the narrator's reason.
post() {
  local t
  t="$(token)"
  curl -sS --fail-with-body -X POST -H 'Content-Type: application/json' \
    --data-binary "$2" "http://127.0.0.1:$PORT/$1?token=$t"
}

cmd_replay() {
  local file="" nvim="" root="" body
  while [ $# -gt 0 ]; do
    case "$1" in
      --nvim) nvim="${2:-}"; shift 2 || die "--nvim needs a socket path" ;;
      --root) root="${2:-}"; shift 2 || die "--root needs a directory" ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$file" ] || die "one tour at a time"; file="$1"; shift ;;
    esac
  done
  [ -n "$file" ] || die "usage: narrator replay <file> [--nvim <socket>] [--root <dir>]"
  [ -f "$file" ] || die "no such file: $file"
  # The server resolves paths against its own working directory, not ours.
  file="$(realpath "$file")"
  [ -z "$root" ] || root="$(realpath "$root")"
  # Started on demand, so that a replay needs nothing but this command. To
  # stderr, since stdout is the JSON reply that Neovim reads.
  pid >/dev/null || cmd_start >&2
  # Built by Python rather than printf, so a quote in a path cannot break it.
  body="$("$APP/venv/bin/python" -I -c '
import json, sys
path, nvim, root = sys.argv[1:]
print(json.dumps({"path": path, "nvim": nvim or None, "project_root": root or None}))
' "$file" "$nvim" "$root")"
  post replay "$body"
  echo
}

cmd_control() {
  case "${1:-}" in
    prev|next|stop|continue) ;;
    *) die "usage: narrator control prev|next|stop|continue" ;;
  esac
  pid >/dev/null || die "the narrator is not running"
  post control "{\"action\": \"$1\"}" >/dev/null
}

case "${1:-}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  log) exec tail -n 50 -F "$LOG" ;;
  replay) shift; cmd_replay "$@" ;;
  control) shift; cmd_control "$@" ;;
  url-path)
    t="$(token)"
    printf '/?token=%s\n' "$t"
    ;;
  *)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
