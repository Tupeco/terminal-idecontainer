#!/usr/bin/env bash
# Orca's headless server, inside this container.
#
#   orca-server start [pairing-address]   start it, detached
#   orca-server stop
#   orca-server status
#   orca-server url                       print the pairing URL again
#   orca-server log                       follow the log
#   orca-server update                    install the latest release and
#                                         restart the server on it
#
# Orca is an IDE for running several coding agents side by side; `serve` is the
# mode where this container owns the projects, worktrees, terminals and agent
# processes, and Orca on your Mac (or phone) is only the UI. The state that
# makes a pairing survive a rebuild lives in ~/.config/orca and ~/.orca, both
# of which are volumes.
#
# Two things worth knowing about running it here:
#
#   * `serve` needs no display. Measured: with DISPLAY unset it still answers
#     on its HTTP port. It runs under Xvfb anyway, as upstream's own systemd
#     unit does, because the browser and Design Mode features do want one.
#     Xvfb is already installed -- the orca-ide package depends on it.
#
#   * Electron refuses to start as root without --no-sandbox, which is why
#     this container's `dev` user is the right one to run it as. If you find
#     yourself running this as root, that is the error you will get.
#
#   * ELECTRON_DISABLE_SANDBOX=1 is required in a container. Chromium's zygote
#     sandboxes itself by creating a user namespace, and Docker's default
#     seccomp profile refuses that syscall:
#
#       Failed to move to new namespace: PID namespaces supported,
#       Network namespace supported, but failed: errno = Operation not permitted
#       FATAL:zygote_host_impl_linux.cc Check failed
#
#     The variable rather than the flag because `orca serve` rejects unknown
#     flags outright ("Unknown flag --no-sandbox for command: serve"); Electron
#     reads the variable before Orca parses anything and passes --no-sandbox
#     down to the zygotes itself. Verified: with it set, the zygote processes
#     carry the switch and the server comes up.
#
#     This gives up a layer of defence in depth *inside* a container that is
#     itself the boundary -- and one already holding your source, your agents
#     and your credentials. The alternative is to hand the container
#     `seccomp=unconfined` or CAP_SYS_ADMIN so Chromium can build its own
#     sandbox, which weakens the outer boundary to strengthen an inner one.
#     Not obviously a good trade for a single-user dev container.
set -euo pipefail

PORT="${ORCA_PORT:-6768}"
SESSION=orca
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/orca-server.log"
REPO=stablyai/orca

die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'warning: %s\n' "$*" >&2; }

# host:port of what the running server advertises, and what it binds, from its
# log. The advertised one is what a client dials; the bound one is inside the
# container, behind the published port.
advertised() {
  sed -n 's|^Advertised endpoint: ws://||p' "$LOG" 2>/dev/null | tail -n1
}

bound() {
  sed -n 's|^Bound endpoint: ws://||p' "$LOG" 2>/dev/null | tail -n1
}

running() { tmux has-session -t "$SESSION" 2>/dev/null; }

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'
}

cmd_start() {
  local addr="${1:-}" quiet="${2:-}"
  if running; then
    # Asking for a different address than the running server advertises is a
    # request it cannot satisfy: the address is baked into the pairing code at
    # startup. Printing the old code here would contradict whatever the caller
    # just said it was advertising, so refuse instead. Not an automatic restart:
    # that would drop any client sessions attached to the server.
    local current want
    current="$(advertised)"
    want="${addr:-$current}"
    case "$want" in
      *:*) ;;
      *) want="$want:${current##*:}" ;;
    esac
    if [ -n "$current" ] && [ "$want" != "$current" ]; then
      printf 'error: already running, advertising %s -- you asked for %s.\n' "$current" "$want" >&2
      printf '  Stop it first, then start it again with the address you want:\n' >&2
      printf '    ./dev orca-stop && ./dev orca %s\n' "$addr" >&2
      exit 1
    fi
    # Report where it listens and leave it alone. Restarting would drop any
    # client sessions attached to it, and the pairing URL is a secret better
    # asked for than printed on every start.
    cmd_status
    echo "Left running. Pairing URL: orca-server url"
    return 0
  fi

  command -v orca-ide >/dev/null \
    || die "this image was built without Orca. On the host: ./dev setup <name> --force --with-orca && ./dev up"
  if [ "$(id -u)" -eq 0 ]; then
    die "run this as an unprivileged user: Electron will not start as root without --no-sandbox"
  fi

  # ~/.config/orca and ~/.orca are Docker volumes. If a volume was created
  # before the image had that directory, Docker owns the mountpoint as root and
  # Orca cannot write its state -- which Electron reports as "Another Orca
  # instance is already running for this userData profile", pointing at entirely
  # the wrong thing. Say what is actually wrong instead.
  local d
  for d in "$HOME/.config/orca" "$HOME/.orca"; do
    mkdir -p "$d" 2>/dev/null || true
    if [ ! -w "$d" ]; then
      printf 'error: %s is not writable by %s.\n' "$d" "$(id -un)" >&2
      printf '  Its Docker volume predates the image creating that directory, so Docker\n' >&2
      printf '  owns the mountpoint as root. Either drop the two volumes from the host --\n' >&2
      printf '    docker volume rm <project>_orca-config <project>_orca-state\n' >&2
      printf '  which only costs you existing pairings -- or, in here:\n' >&2
      printf '    sudo chown -R %s %s\n' "$(id -un)" "$d" >&2
      exit 1
    fi
  done

  # An address belonging to this container is not reachable from anywhere else:
  # clients dial the *host*, which forwards the published port inward.
  if [ -n "$addr" ]; then
    local own
    for own in $(hostname -I 2>/dev/null); do
      if [ "$own" = "${addr%:*}" ] || [ "$own" = "$addr" ]; then
        warn "${addr%:*} is this container's own address on the Docker network."
        warn "Clients cannot route to it -- use the host machine's address instead."
      fi
    done
  fi

  local args=(serve --port "$PORT")
  [ -n "$addr" ] && args+=(--pairing-address "$addr")

  mkdir -p "$(dirname "$LOG")"
  : > "$LOG"

  # tmux rather than a bare background process so you can attach and watch it,
  # and so it outlives the shell that started it -- the same reason the editor
  # runs in tmux here.
  tmux new-session -d -s "$SESSION" \
    "exec env LIBGL_ALWAYS_SOFTWARE=1 ELECTRON_DISABLE_SANDBOX=1 \
       xvfb-run -a orca-ide ${args[*]} 2>&1 | tee -a '$LOG'"

  # The pairing URL is what you paste into the client, so wait for it rather
  # than returning a prompt and leaving you to go looking.
  for _ in $(seq 60); do
    if grep -q '^Pairing URL:' "$LOG" 2>/dev/null; then
      echo "Orca server listening on port $PORT (tmux session '$SESSION')"
      [ -n "$quiet" ] || cmd_url
      return 0
    fi
    running || { echo "--- log ---"; cat "$LOG"; die "the server exited; see above"; }
    sleep 1
  done
  echo "--- log so far ---"
  cat "$LOG"
  die "no pairing URL after 60s"
}

cmd_stop() {
  running || { echo "not running"; return 0; }
  local pgid _
  # The pane's process group: xvfb-run, Xvfb, and the server with its Electron
  # helpers. Deliberately not every orca-ide process: Orca runs its agents'
  # terminals from a daemon (daemon-entry.js) in a session of its own, so that
  # they outlive the server, and the shell running this may well be one of
  # them. Killing the tmux session never reaches that daemon, and neither
  # does the wait below.
  pgid="$(tmux list-panes -t "$SESSION" -F '#{pane_pid}' 2>/dev/null | head -n1)"
  tmux kill-session -t "$SESSION"
  # Gone from tmux is not gone. Electron takes a moment to shut its helpers
  # down, and a server started again meanwhile could find the old one still
  # holding its single-instance lock.
  if [ -n "$pgid" ]; then
    for _ in $(seq 40); do
      pgrep -g "$pgid" >/dev/null || break
      sleep 0.25
    done
    if pgrep -g "$pgid" >/dev/null; then
      warn "Orca's server processes are still exiting after 10s"
    fi
  fi
  echo "stopped"
}

installed_version() {
  dpkg-query -W -f='${Version}' orca-ide 2>/dev/null || true
}

# The newest release, from where GitHub's releases/latest page redirects to:
# .../releases/tag/v<version>. Unlike the API, that needs no token and has no
# rate limit to trip over.
latest_version() {
  local url
  url="$(curl -fsSIL -o /dev/null -w '%{url_effective}' \
           "https://github.com/$REPO/releases/latest")" || return 1
  url="${url##*/tag/}"
  printf '%s\n' "${url#v}"
}

# Install the latest release over the one the image was built with, and
# restart the server on it if it was running, at the address it advertised.
# Pairings live in volumes, so clients reconnect without pairing again.
#
# This changes the container, not the image: it lasts until the container is
# recreated (by `./dev rebuild`, or an `./dev up` after a change), which puts
# it back on ORCA_VERSION. Hence the reminder at the end to bump the pin.
cmd_update() {
  local current latest arch tmp now addr=""
  command -v orca-ide >/dev/null \
    || die "this image was built without Orca. On the host: ./dev setup <name> --force --with-orca && ./dev up"
  current="$(installed_version)"
  latest="$(latest_version)" \
    || die "could not reach GitHub to find the latest Orca release"
  [[ "$latest" =~ ^[0-9]+(\.[0-9]+)+$ ]] \
    || die "could not make out the latest Orca release from GitHub (got: $latest)"
  # gt rather than !=, so a pin newer than GitHub's "latest" (which skips
  # pre-releases) is never downgraded.
  if [ -n "$current" ] && ! dpkg --compare-versions "$latest" gt "$current"; then
    echo "Orca $current is up to date (latest release: $latest)."
    return 0
  fi

  case "$(dpkg --print-architecture)" in
    amd64) arch=amd64 ;;
    arm64) arch=arm64 ;;
    *) die "no Orca release for $(dpkg --print-architecture)" ;;
  esac

  echo "Updating Orca ${current:-(unknown)} -> $latest"
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064  # expand now: $tmp is local and gone by exit
  trap "rm -rf '$tmp'" EXIT
  # Readable by apt's unprivileged _apt user, or apt warns that it had to
  # fall back to reading the file as root.
  chmod 0755 "$tmp"
  curl -fSL --progress-bar -o "$tmp/orca.deb" \
    "https://github.com/$REPO/releases/download/v$latest/orca-ide_${latest}_$arch.deb" \
    || die "could not download Orca $latest; ${current:-the old version} is still installed"
  chmod 0644 "$tmp/orca.deb"

  # The image deletes apt's package lists to stay small, and apt needs them for
  # any dependency the new version adds. env because sudo resets the
  # environment, DEBIAN_FRONTEND with it.
  sudo env DEBIAN_FRONTEND=noninteractive apt-get update -qq \
    || die "apt-get update failed; Orca ${current:-the old version} is still installed"
  sudo env DEBIAN_FRONTEND=noninteractive \
    apt-get install -y -qq --no-install-recommends "$tmp/orca.deb" \
    || die "installing Orca $latest failed; ${current:-the old version} is still installed"

  now="$(installed_version)"
  [ "$now" = "$latest" ] \
    || die "the install finished, but dpkg reports Orca ${now:-(none)} rather than $latest"

  if running; then
    addr="$(advertised)"
    echo "Restarting the server on $now..."
    cmd_stop >/dev/null
    cmd_start "$addr" quiet
  fi

  echo
  echo "Updated Orca ${current:-(unknown)} -> $now."
  [ -n "$addr" ] || echo "The server was not running; start it with ./dev orca."
  echo "This lasts until the container is recreated. To keep $now from then on,"
  echo "set ARG ORCA_VERSION=$now in .devcontainer/Dockerfile."
}

cmd_status() {
  if ! running; then
    echo "not running"
    return 1
  fi
  local a b
  a="$(advertised)"
  b="$(bound)"
  if [ -n "$a" ]; then
    printf "running: clients dial ws://%s (bound ws://%s, tmux session '%s')\n" \
      "$a" "${b:-0.0.0.0:$PORT}" "$SESSION"
  else
    printf "running (tmux session '%s'), port %s; no endpoint in the log yet\n" \
      "$SESSION" "$PORT"
  fi
}

cmd_url() {
  [ -f "$LOG" ] || die "no log at $LOG; has it been started?"
  local url
  url="$(sed -n 's/^Pairing URL: //p' "$LOG" | tail -n1)"
  [ -n "$url" ] || die "no pairing URL in $LOG yet"
  printf '\nPairing URL (treat it like a password):\n\n  %s\n\n' "$url"
  sed -n 's/^Advertised endpoint: /Advertised endpoint: /p' "$LOG" | tail -n1
  show_qr "$url"
}

# The pairing URL runs to a few hundred characters with its keys, which is
# tedious to get onto a phone any other way. Only on a terminal: captured or
# piped output gets the URL alone. And only when it fits, because a QR code
# wrapped at the terminal's edge does not scan.
show_qr() {
  local qr width cols
  [ -t 1 ] || return 0
  command -v qrencode >/dev/null || return 0
  qr="$(qrencode -t utf8 "$1")"
  # Characters, not bytes: each module is a multi-byte block glyph.
  width="$(printf '%s' "${qr%%$'\n'*}" | LC_ALL=C.UTF-8 wc -m)"
  cols="$(tput cols 2>/dev/null || echo 80)"
  if [ "$width" -gt "$cols" ]; then
    printf '\nThe QR code needs %d columns and this terminal has %d.\n' "$width" "$cols"
    printf 'Widen it and run ./dev orca-url to see the code.\n'
    return 0
  fi
  printf '\n%s\n' "$qr"
}

cmd_log() {
  [ -f "$LOG" ] || die "no log at $LOG; has it been started?"
  tail -n 40 -f "$LOG"
}

case "${1:-}" in
  start) shift; cmd_start "${1:-}" ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  url) cmd_url ;;
  log) cmd_log ;;
  update) cmd_update ;;
  -h | --help | help | "") usage ;;
  *) usage >&2; exit 2 ;;
esac
